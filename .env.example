# Anvil's well-known test key is fine for a local fork. Never commit a key that holds real BTC.
PRIVATE_KEY=
MEZO_TESTNET_RPC=https://rpc.test.mezo.org

# Keeper. Live factory (block 16408314). The quiet-guard fix in this branch needs a newer factory.
# The key stays out of git. Dry-run needs no key.
COIL_FACTORY=0xff3335576f998EE872596d4EB7ABECb71a0D5BC8
KEEPER_PRIVATE_KEY=
COIL_EXECUTE=false
KEEPER_WATCH=false
KEEPER_POLL_MS=20000
# After guard() simulates false, skip that account until its ratio changes or this many milliseconds pass.
KEEPER_QUIET_MS=300000
WATCHES_PATH=

# Optional. The keeper runs with either of these empty. Add both on Railway later.
# The token is not printed. Do not commit a real one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend (web/). Same default as web/src/lib/mezo.ts.
NEXT_PUBLIC_COIL_FACTORY=0xff3335576f998EE872596d4EB7ABECb71a0D5BC8
# Public WalletConnect id from https://cloud.walletconnect.com. Not a secret. Passport uses it for the EVM WalletConnect option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
