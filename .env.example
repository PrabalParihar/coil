# Anvil's well-known test key is fine for a local fork. Never commit a key that holds real BTC.
PRIVATE_KEY=
MEZO_TESTNET_RPC=https://rpc.test.mezo.org

# Keeper. Live Wave 2 factory. A rescue-slippage redeploy will replace this address.
# The key stays out of git. Dry-run needs no key.
COIL_FACTORY=0x6A38f560cF8612cc81cF966831890DBb310e31F7
KEEPER_PRIVATE_KEY=
COIL_EXECUTE=false
KEEPER_WATCH=false
KEEPER_POLL_MS=20000
WATCHES_PATH=

# Optional. The keeper runs with both unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend (web/). Same default as web/src/lib/mezo.ts. The live site already sets this.
# The rescue-slippage split is not on this factory until a new one is deployed.
NEXT_PUBLIC_COIL_FACTORY=0x6A38f560cF8612cc81cF966831890DBb310e31F7
# Public WalletConnect id from https://cloud.walletconnect.com. Not a secret. Passport uses it for the EVM WalletConnect option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
