# Anvil's well-known test key is fine for a local fork. Never commit a key that holds real BTC.
PRIVATE_KEY=
MEZO_TESTNET_RPC=https://rpc.test.mezo.org

# Keeper. This is the live Wave 1 factory. Point it at the Wave 2 factory after deploy.
# The key stays out of git. Dry-run needs no key.
COIL_FACTORY=0xE29fAf17ed44B43c94D2Ff0e43E289aE49D98a3e
KEEPER_PRIVATE_KEY=
COIL_EXECUTE=false
KEEPER_WATCH=false
KEEPER_POLL_MS=20000
WATCHES_PATH=

# Optional. The keeper runs with both unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend (web/). The app also falls back to the Wave 1 factory when the variable is unset.
# Set this to the Wave 2 factory after deploy so flashLoop, MEZO tips, and the guard log light up.
NEXT_PUBLIC_COIL_FACTORY=0xE29fAf17ed44B43c94D2Ff0e43E289aE49D98a3e
# Public WalletConnect id from https://cloud.walletconnect.com. Not a secret. Passport uses it for the EVM WalletConnect option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
