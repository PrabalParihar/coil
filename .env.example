# Anvil's well-known test key is fine for a local fork. Never commit a key that holds real BTC.
PRIVATE_KEY=
MEZO_TESTNET_RPC=https://rpc.test.mezo.org
MEZO_MAINNET_RPC=https://mezo.drpc.org

# Public configuration. This is the legacy production pair; new features need a
# verified new deployment and a manifest update. Address/block overrides are paired.
COIL_CHAIN_ID=31611
COIL_FACTORY=0xff3335576f998EE872596d4EB7ABECb71a0D5BC8
COIL_FACTORY_DEPLOY_BLOCK=16408315
COIL_EXPECTED_KEEPER=0x1D2621480011C44693a47801C1158E70b25b4B4F
COIL_MAINNET_ENABLED=false

# New deployment bootstrap: testnet-only finite limits in raw 18-decimal units.
# Mainnet requires reviewed explicit limits and its separate go-live decision.
COIL_MAX_COLLATERAL=1000000000000000000
COIL_MAX_DEBT=100000000000000000000000
COIL_KEEPER=0x1D2621480011C44693a47801C1158E70b25b4B4F
COIL_GUARDIAN=0xf74E746a8d7A46A8b0f745C6d5944Ee672c1a3AF
COIL_MAINNET_APPROVED=false

# Keeper. Monitoring needs no signing key. Execute only with its configured identity.
KEEPER_PRIVATE_KEY=
COIL_EXECUTE=false
KEEPER_WATCH=false
KEEPER_POLL_MS=20000
PORT=3000
WATCHES_PATH=

# Optional. The keeper runs with either of these empty. Add both on Railway later.
# The token is not printed. Do not commit a real one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend (web/). Set both address and block or omit both to use the manifest.
NEXT_PUBLIC_COIL_CHAIN_ID=31611
NEXT_PUBLIC_COIL_FACTORY=0xff3335576f998EE872596d4EB7ABECb71a0D5BC8
NEXT_PUBLIC_COIL_FACTORY_DEPLOY_BLOCK=16408315
NEXT_PUBLIC_COIL_ENABLE_MAINNET_WRITES=false
# Optional public keeper /status endpoint. Omit until a real HTTPS endpoint exists.
# The UI validates its chain/factory/identity and labels read-only monitoring.
NEXT_PUBLIC_KEEPER_STATUS_URL=
# Optional public id from https://cloud.walletconnect.com. WalletConnect stays
# unavailable when absent; injected and supported Bitcoin wallets remain usable.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
